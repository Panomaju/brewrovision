{
    "name": "brewrovision",
    "version": "2.0.0",
    "type": "module",
    "description": "Score keeping + stream overlay for the Panomaju Invitational homebrew competition",
    "scripts": {
        "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
        "dev:server": "tsx watch src/server/index.ts",
        "dev:client": "vite",
        "build": "vite build",
        "start": "NODE_ENV=production tsx src/server/index.ts",
        "migrate": "tsx src/server/migrate.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.3",
        "@hono/node-ws": "^1.2.0",
        "@lit-labs/motion": "^1.0.7",
        "hono": "^4.9.8",
        "kysely": "^0.27.4",
        "lit": "^3.2.1",
        "pg": "^8.13.1",
        "suunta": "^4.7.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.13",
        "@types/node": "^20.11.17",
        "@types/pg": "^8.11.10",
        "concurrently": "^9.1.0",
        "tailwindcss": "^4.1.13",
        "tsx": "^4.7.1",
        "typescript": "^5.8.3",
        "vite": "^6.0.11"
    }
}
